#include <winver.h>
#define VER_NUM 1,0,0,0
#define VER_STR "1.0.0.0"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "atruenut"
      VALUE "FileDescription", RC_DESC
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", RC_INTERNAL
      VALUE "LegalCopyright", "Copyright (c) 2026 atruenut. MIT License."
      VALUE "OriginalFilename", RC_ORIGINAL
      VALUE "ProductName", "Mouthpiece"
      VALUE "ProductVersion", VER_STR
      VALUE "Comments", "https://github.com/atruenut/mouthpiece"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
